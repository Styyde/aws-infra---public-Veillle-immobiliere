# Ignorer le dossier .terraform (modules, providers téléchargés)
.terraform/
.terraform.lock.hcl

# Ignorer les fichiers d'état (locaux)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Ignorer les fichiers de variables sensibles
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
# terraform.tfvars ne contient aucun secret (juste l'identité des repos GitHub) :
# il doit être versionné pour que la trust policy OIDC reste correcte.
!terraform.tfvars

# Ignorer les fichiers de plan Terraform
# ("*.plan" ne matchait pas "*.tfplan" -> un plan peut contenir des valeurs
# sensibles en clair (mots de passe RDS/Grafana, etc.) même quand la sortie
# CLI les masque -- ne jamais committer un fichier de plan.
*.plan
*.tfplan
*.out

# Script de bootstrap rendu (généré depuis scripts/bootstrap.sh.tpl via
# `terraform output -raw bootstrap_script`) : artefact de sortie, pas une
# source à versionner.
bootstrap.sh

# Ignorer les logs, traces, fichiers de test
*.log
crash.log
crash.*.log

# Ignorer les fichiers de configuration de l'éditeur
.vscode/
.idea/
*.swp
*.swo
*~

# Ignorer les fichiers système
.DS_Store
Thumbs.db